# Copie para .env (git-ignorado) e preencha com as credenciais reais do
# projeto Supabase. NUNCA coloque a service_role key aqui — o app Flutter só
# usa a anon key. A service_role é usada apenas por Edge Functions (o
# próprio Supabase já injeta SUPABASE_SERVICE_ROLE_KEY no runtime delas,
# sem precisar declarar aqui) e por scripts administrativos locais, se um
# dia forem necessários — nesse caso, cada dev guarda a sua própria cópia,
# nunca comitada.

SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx
